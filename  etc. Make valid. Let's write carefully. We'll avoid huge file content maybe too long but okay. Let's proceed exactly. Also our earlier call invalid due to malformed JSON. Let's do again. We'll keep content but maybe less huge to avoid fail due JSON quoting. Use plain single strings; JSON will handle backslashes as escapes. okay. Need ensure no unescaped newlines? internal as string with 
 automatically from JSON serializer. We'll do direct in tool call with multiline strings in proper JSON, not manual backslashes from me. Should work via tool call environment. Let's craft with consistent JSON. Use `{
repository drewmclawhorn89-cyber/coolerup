"path":"src/routes/paywall.tsx","content":"import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { useEffect, useState } from "react";
import { toast } from "sonner";
import { Button } from "@/components/ui/button";
import { useAuth } from "@/hooks/useAuth";
import { canAccessAppForUser, fetchLatestSubscription, isOwnerUsername } from "@/lib/subscription";
import { createMonthlyCheckout, formatCurrency, MONTHLY_PLAN_CONFIG, type MonthlyPlan } from "@/lib/stripe";

export const Route = createFileRoute("/paywall")({
  head: () => ({
    meta: [
      { title: "Coolerup — Subscribe" },
      { name: "description", content: "Monthly subscription plans for Coolerup." },
      { name: "theme-color", content: "#000000" },
    ],
  }),
  component: PaywallPage,
});

function PaywallPage() {
  const auth = useAuth();
  const navigate = useNavigate();
  const [checking, setChecking] = useState(true);

  useEffect(() => {
    if (!auth.ready) return;
    if (!auth.user) {
      setChecking(false);
      return;
    }

    let alive = true;
    void (async () => {
      const allowed = await canAccessAppForUser({ id: auth.user?.id ?? null, handle: auth.handle });
      if (!alive) return;
      if (allowed) {
        void navigate({ to: "/", replace: true });
        return;
      }
      setChecking(false);
    })();

    return () => {
      alive = false;
    };
  }, [auth.ready, auth.user, auth.handle, navigate]);

  const handlePlan = async (plan: MonthlyPlan) => {
    if (!auth.user) {
      auth.signIn();
      return;
    }

    const result = await createMonthlyCheckout(plan);
    if (!result.ok) {
      toast.error(result.message);
      return;
    }

    if (result.url) {
      window.location.assign(result.url);
    }
  };

  if (checking) {
    return (
      <main className="flex min-h-dvh items-center justify-center bg-black px-4 text-white">
        <p className="text-sm text-white/60">Checking your account…</p>
      </main>
    );
  }

  return (
    <main className="min-h-dvh bg-black text-white" style={{ paddingBottom: "calc(1.5rem + env(safe-area-inset-bottom))" }}>
      <div className="mx-auto flex min-h-dvh max-w-6xl flex-col justify-center px-4 py-8 sm:px-6 lg:px-8">
        <div className="mx-auto w-full max-w-4xl">
          <div className="mb-8 text-center">
            <div className="mb-4 inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-semibold uppercase tracking-[0.25em] text-white/75">
              <span className="inline-block h-2.5 w-2.5 rounded-full bg-[#ff4fa3]" />
              Coolerup
            </div>
            <h1 className="text-4xl font-black tracking-tight sm:text-5xl lg:text-6xl">
              Watch Coolerup for $4.99/month
            </h1>
            <p className="mx-auto mt-4 max-w-2xl text-base text-white/70 sm:text-lg">
              Stream, follow, search, browse LIVE, and keep access to your favorite content.
            </p>
          </div>

          <div className="grid gap-5 md:grid-cols-2">
            {(Object.keys(MONTHLY_PLAN_CONFIG) as MonthlyPlan[]).map((planKey) => {
              const plan = MONTHLY_PLAN_CONFIG[planKey];
              const featured = planKey === "premium";
              return (
                <article
                  key={plan.id}
                  className={`rounded-[28px] border p-6 shadow-[0_25px_90px_rgba(0,0,0,0.5)] ${
                    featured
                      ? "border-[#ff4fa3]/60 bg-gradient-to-b from-[#1a0d16] to-[#0a0a0a]"
                      : "border-white/10 bg-white/[0.04]"
                  }`}
                >
                  <div className="flex items-start justify-between gap-4">
                    <div>
                      <p className="text-sm font-semibold uppercase tracking-[0.2em] text-white/60">
                        {plan.label}
                      </p>
                      <div className="mt-3 flex items-end gap-2">
                        <span className="text-4xl font-black text-white">{formatCurrency(plan.price)}</span>
                        <span className="pb-1 text-sm text-white/60">/month</span>
                      </div>
                    </div>
                    {featured && (
                      <span className="rounded-full bg-[#ff4fa3] px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.2em] text-white">
                        best value
                      </span>
                    )}
                  </div>

                  <ul className="mt-5 space-y-3 text-sm text-white/75">
                    {plan.features.map((feature) => (
                      <li key={feature} className="flex items-center gap-2">
                        <span className="inline-block h-2 w-2 rounded-full bg-[#ff4fa3]" />
                        {feature}
                      </li>
                    ))}
                  </ul>

                  <Button
                    className="mt-6 w-full rounded-full bg-[#ff4fa3] px-5 py-6 text-base font-bold text-white hover:bg-[#ff3b96]"
                    onClick={() => void handlePlan(planKey)}
                  >
                    Subscribe Now
                  </Button>
                </article>
              );
            })}
          </div>
        </div>
      </div>
    </main>
  );
}
"path":"src/routes/subscription.tsx","content":"import { createFileRoute, useNavigate } from "@tanstack/react-router";
import { useEffect, useMemo, useState } from "react";
import { ChevronLeft, Crown, ShieldCheck } from "lucide-react";
import { toast } from "sonner";
import { Button } from "@/components/ui/button";
import { useAuth } from "@/hooks/useAuth";
import { supabase } from "@/integrations/supabase/client";
import {
  fetchLatestSubscription,
  formatPremiumUntil,
  isOwnerUsername,
  isSubscriptionActive,
  type SubscriptionRow,
} from "@/lib/subscription";

export const Route = createFileRoute("/subscription")({
  head: () => ({
    meta: [
      { title: "Subscription — Coolerup" },
      { name: "description", content: "Manage your Coolerup subscription." },
    ],
  }),
  component: SubscriptionPage,
});

function SubscriptionPage() {
  const auth = useAuth();
  const navigate = useNavigate();
  const [sub, setSub] = useState<SubscriptionRow | null>(null);
  const [loading, setLoading] = useState(true);
  const [busy, setBusy] = useState(false);

  useEffect(() => {
    if (!auth.ready) return;
    if (!auth.user) {
      void navigate({ to: "/paywall", replace: true });
      return;
    }

    let alive = true;
    void (async () => {
      if (isOwnerUsername(auth.handle)) {
        setSub({
          id: "owner-free",
          user_id: auth.user!.id,
          plan: "premium",
          status: "active",
          stripe_customer_id: null,
          current_period_end: null,
          created_at: new Date().toISOString(),
        });
        setLoading(false);
        return;
      }

      const current = await fetchLatestSubscription(auth.user!.id);
      if (!alive) return;
      setSub(current);
      setLoading(false);
    })();

    return () => {
      alive = false;
    };
  }, [auth.ready, auth.user, auth.handle, navigate]);

  const active = useMemo(() => isSubscriptionActive(sub), [sub]);

  const handleCancel = async () => {
    if (!auth.user) return;
    if (isOwnerUsername(auth.handle)) {
      toast.info("This account always has Premium access.");
      return;
    }

    setBusy(true);
    try {
      const { error } = await supabase
        .from("subscriptions")
        .update({ status: "canceled" })
        .eq("user_id", auth.user.id)
        .order("created_at", { ascending: false })
        .limit(1);

      if (error) throw error;

      const current = await fetchLatestSubscription(auth.user.id);
      setSub(current ? { ...current, status: "canceled" } : current);
      toast.success("Your subscription stays active until the end of the current month.");
    } catch (error) {
      const message = error instanceof Error ? error.message : "Could not cancel your subscription.";
      toast.error(message);
    } finally {
      setBusy(false);
    }
  };

  if (loading) {
    return (
      <main className="flex min-h-dvh items-center justify-center bg-black px-4 text-white">
        <p className="text-sm text-white/60">Loading your subscription…</p>
      </main>
    );
  }

  return (
    <main className="min-h-dvh bg-black text-white" style={{ paddingBottom: "calc(1rem + env(safe-area-inset-bottom))" }}>
      <div className="mx-auto max-w-2xl px-4 py-6 sm:px-6">
        <button
          type="button"
          onClick={() => void navigate({ to: "/" })}
          className="mb-6 inline-flex items-center gap-2 text-sm text-white/70 hover:text-white"
        >
          <ChevronLeft className="h-4 w-4" />
          Back to app
        </button>

        <div className="rounded-[32px] border border-white/10 bg-white/[0.04] p-6 shadow-[0_20px_60px_rgba(0,0,0,0.45)]">
          <div className="flex items-center justify-between gap-4">
            <div>
              <p className="text-xs font-semibold uppercase tracking-[0.2em] text-white/50">Subscription</p>
              <h1 className="mt-2 text-3xl font-black">{isOwnerUsername(auth.handle) ? "Owner free" : "Plan details"}</h1>
            </div>
            {isOwnerUsername(auth.handle) ? (
              <span className="inline-flex items-center gap-2 rounded-full bg-emerald-500/15 px-3 py-1.5 text-sm font-semibold text-emerald-300">
                <ShieldCheck className="h-4 w-4" /> Owner free
              </span>
            ) : (
              <span className="inline-flex items-center gap-2 rounded-full bg-[#ff4fa3]/15 px-3 py-1.5 text-sm font-semibold text-[#ff9ac5]">
                <Crown className="h-4 w-4" /> {sub?.plan === "premium" ? "Premium" : "Basic"}
              </span>
            )}
          </div>

          <div className="mt-6 rounded-2xl border border-white/10 bg-black/25 p-4">
            <p className="text-sm text-white/60">Current status</p>
            <p className="mt-2 text-xl font-bold">
              {isOwnerUsername(auth.handle)
                ? "Premium — active forever"
                : active
                  ? formatPremiumUntil(sub?.current_period_end)
                  : sub?.status === "canceled"
                    ? "Canceled — access ends at the end of the billing cycle"
                    : "Not active"}
            </p>
          </div>

          {!isOwnerUsername(auth.handle) && (
            <div className="mt-6 flex flex-col gap-3 sm:flex-row">
              <Button
                className="flex-1 bg-[#ff4fa3] text-white hover:bg-[#ff3d97]"
                onClick={() => void navigate({ to: "/paywall" })}
              >
                {active ? "Upgrade plan" : "Choose a plan"}
              </Button>
              {active && (
                <Button variant="secondary" className="flex-1" onClick={handleCancel} disabled={busy}>
                  {busy ? "Canceling…" : "Cancel"}
                </Button>
              )}
            </div>
          )}

          <div className="mt-6 space-y-2 border-t border-white/10 pt-6 text-sm text-white/70">
            <p>• Monthly pricing only</p>
            <p>• Cancel anytime and keep the remainder of your current billing period</p>
            <p>• Payment failures or cancellations mark the user inactive immediately</p>
          </div>
        </div>
      </div>
    </main>
  );
}
