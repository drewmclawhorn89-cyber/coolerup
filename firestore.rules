rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /accountThemes/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['theme'])
        && request.resource.data.theme in ['light','dark','system','blue','purple','pink','green','red'];
    }

    // Default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidHandle(handle) {
      return handle is string && handle.size() >= 1 && handle.size() <= 40 && handle.matches('^[a-z0-9._]+$');
    }

    function isValidUserPresence(data) {
      return data.keys().hasAll(['uid', 'handle', 'isOnline', 'lastActive', 'showOnline', 'createdAt'])
        && data.keys().hasOnly(['uid', 'handle', 'isOnline', 'lastActive', 'showOnline', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && isValidHandle(data.handle)
        && data.isOnline is bool
        && data.showOnline is bool
        && (data.showOnline == true || data.isOnline == false)
        && data.lastActive is timestamp
        && data.createdAt is timestamp;
    }

    function isPresenceStatusUpdate() {
      return existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().handle == existing().handle
        && incoming().createdAt == existing().createdAt
        && incoming().lastActive == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['isOnline', 'lastActive', 'showOnline']);
    }

    function isValidWatchSource(source) {
      return source in ['foryou', 'videos', 'youtube', 'tiktok', 'instagram'];
    }

    function isValidWatchHistoryEntry(data) {
      return data.keys().hasAll([
          'uid',
          'videoId',
          'source',
          'title',
          'creator',
          'thumbnailUrl',
          'videoUrl',
          'sourceUrl',
          'watchRouteId',
          'youtubeId',
          'watchedAt',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'videoId',
          'source',
          'title',
          'creator',
          'thumbnailUrl',
          'videoUrl',
          'sourceUrl',
          'watchRouteId',
          'youtubeId',
          'watchedAt',
          'createdAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.videoId is string && data.videoId.size() >= 1 && data.videoId.size() <= 180
        && data.source is string && isValidWatchSource(data.source)
        && data.title is string && data.title.size() <= 300
        && data.creator is string && data.creator.size() <= 100
        && data.thumbnailUrl is string && data.thumbnailUrl.size() <= 1000
        && data.videoUrl is string && data.videoUrl.size() <= 1000
        && data.sourceUrl is string && data.sourceUrl.size() <= 1000
        && data.watchRouteId is string && data.watchRouteId.size() <= 180
        && data.youtubeId is string && data.youtubeId.size() <= 64
        && data.watchedAt is timestamp
        && data.createdAt is timestamp;
    }

    function isWatchHistoryUpdate() {
      return existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().watchedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'videoId',
          'source',
          'title',
          'creator',
          'thumbnailUrl',
          'videoUrl',
          'sourceUrl',
          'watchRouteId',
          'youtubeId',
          'watchedAt'
        ]);
    }

    function isValidWatchHistorySettings(data, userId) {
      return data.keys().hasAll(['uid', 'saveWatchHistory', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'saveWatchHistory', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.saveWatchHistory is bool
        && data.updatedAt is timestamp;
    }

    match /user_presence/{presenceId} {
      allow get: if isSignedIn()
        && isValidId(presenceId)
        && (resource == null || existing().uid == request.auth.uid || existing().showOnline == true);

      allow list: if isSignedIn()
        && (resource.data.uid == request.auth.uid || resource.data.showOnline == true);

      allow create: if isSignedIn()
        && isValidId(presenceId)
        && isValidUserPresence(incoming())
        && incoming().createdAt == request.time
        && incoming().lastActive == request.time;

      allow update: if isSignedIn()
        && isValidId(presenceId)
        && isValidUserPresence(incoming())
        && isPresenceStatusUpdate();

      allow delete: if isSignedIn()
        && isValidId(presenceId)
        && existing().uid == request.auth.uid;
    }

    match /watch_history/{historyDocId} {
      allow get: if isSignedIn()
        && isValidId(historyDocId)
        && (resource == null || existing().uid == request.auth.uid);

      allow list: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(historyDocId)
        && isValidWatchHistoryEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().watchedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(historyDocId)
        && isValidWatchHistoryEntry(incoming())
        && isWatchHistoryUpdate();

      allow delete: if isSignedIn()
        && isValidId(historyDocId)
        && existing().uid == request.auth.uid;
    }

    match /watch_history_settings/{userId} {
      allow get: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId;

      allow list: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidWatchHistorySettings(incoming(), userId)
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidWatchHistorySettings(incoming(), userId)
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['saveWatchHistory', 'updatedAt']);

      allow delete: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && existing().uid == request.auth.uid;
    }
  }
}
