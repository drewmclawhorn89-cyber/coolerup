import { useState } from "react";
import { supabase } from "@/integrations/supabase/client";

export default function Upload() {
  const myUsername = "drew";
  const [file, setFile] = useState<File | null>(null);
  const [caption, setCaption] = useState("");
  const [loading, setLoading] = useState(false);

  const upload = async () => {
    if(!file) return alert("Pick a pic or video!");
    setLoading(true);
    const isImage = file.type.startsWith("image");
    const path = `${myUsername}/${Date.now()}_${file.name}`;

    const { error: upErr } = await supabase.storage.from("post-images").upload(path, file);
    if(upErr){ alert(upErr.message); setLoading(false); return; }

    const { data: urlData } = supabase.storage.from("post-images").getPublicUrl(path);

    // save to your videos table (works for pics too)
    const { error } = await supabase.from("videos").insert({
      username: myUsername,
      caption: caption,
      image_url: isImage? urlData.publicUrl : null,
      video_url:!isImage? urlData.publicUrl : null,
      type: isImage? "image" : "video"
    });

    if(error) alert(error.message);
    else { alert("Posted!"); window.location.href="/"; }
    setLoading(false);
  };

  return (
    <div className="min-h-screen bg-black text-white p-6 max-w-md mx-auto">
      <h1 className="text-2xl font-bold mb-4">Post a Pic or Video</h1>
      <input type="file" accept="image/*,video/*" onChange={e=>setFile(e.target.files?.[0]||null)} className="w-full bg-zinc-900 p-3 rounded-xl mb-3" />
      {file && <p className="text-xs text-zinc-400 mb-2">{file.name} - {file.type.startsWith("image")? "Photo" : "Video"}</p>}
      <input value={caption} onChange={e=>setCaption(e.target.value)} placeholder="Caption..." className="w-full bg-zinc-900 border border-zinc-800 rounded-full px-4 py-2 mb-4" />
      <button onClick={upload} disabled={loading} className="w-full bg-[#00f2ea] text-black py-3 rounded-full font-bold">
        {loading? "Posting..." : "Post for Everyone"}
      </button>
      <p className="text- text-zinc-500 mt-3 text-center">Anyone can post pics or videos. Public feed.</p>
    </div>
  );
}
