# Copy to `.env` for local development.
#
# Only `VITE_*` variables are readable by the browser. Everything else is
# server-only. Never add a `VITE_` prefix to a secret: TanStack Start inlines
# every `VITE_*` value into the client bundle.

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Web Push public key (public-safe: sent to every browser).
VITE_VAPID_PUBLIC_KEY=

# Server-side only. Read per request by src/lib/giphy.functions.ts.
GIPHY_API_KEY=
