import { useEffect, useState } from "react";
import { supabase } from "@/lib/supabase";

type Notif = {
  id: string;
  type: string;
  text: string;
  created_at: string;
  video_id?: string;
  actor_id?: string;
};

export function NotificationsInbox() {
  const [notifs, setNotifs] = useState<Notif[]>([]);
  const [loading, setLoading] = useState(true);
  const [userId, setUserId] = useState<string | null>(null);

  useEffect(() => {
    (async () => {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) {
        setLoading(false);
        return;
      }
      setUserId(user.id);
      
      const { data, error } = await supabase
        .from("notifications")
        .select("*")
        .eq("target_user_id", user.id)
        .order("created_at", { ascending: false })
        .limit(50);

      if (error) console.error(error);
      if (data) setNotifs(data as any);
      setLoading(false);
    })();
  }, []);

  if (loading) return <div className="p-10 pt-20 text-center text-white/60">Loading inbox...</div>;
  
  if (!userId) {
    return <div className="p-10 pt-20 text-center">Please log in to see inbox.<br/>Notifications are saved to your ACCOUNT.</div>;
  }

  if (notifs.length === 0) {
    return (
      <div className="p-10 pt-20 text-center text-white/60">
        <div className="text-5xl mb-4">📥</div>
        <p className="text-lg">No notifications yet</p>
        <p className="text-sm mt-2">When someone likes your fit, it will appear here.<br/>Saved to your ACCOUNT so it follows you on any device.</p>
      </div>
    );
  }

  return (
    <div className="p-4 pt-20 max-w-2xl mx-auto space-y-3">
      <h2 className="text-2xl font-bold mb-6">Inbox - Saved to Account</h2>
      {notifs.map((n) => (
        <div key={n.id} className="p-4 bg-white/10 rounded-xl border border-white/10">
          <p className="font-medium">{n.text || `${n.type} notification`}</p>
          {n.video_id && <p className="text-xs text-white/50 mt-1">Video: {n.video_id.slice(0,8)}...</p>}
          <p className="text-xs text-white/40 mt-2">{new Date(n.created_at).toLocaleString()}</p>
        </div>
      ))}
    </div>
  );
}
