import { useEffect, useState } from "react";
import { supabase } from "@/integrations/supabase/client";

export default function Admin() {
  const myUsername = "drew";
  if(myUsername!== "drew") return <div className="p-10 text-white">Not allowed</div>;
  const [reports, setReports] = useState<any[]>([]);
  const [banned, setBanned] = useState<any[]>([]);
  useEffect(()=>{ load(); },[]);
  const load = async () => {
    const {data: r} = await supabase.from("reports").select("*").order("created_at",{ascending:false});
    const {data: b} = await supabase.from("banned_users").select("*").order("banned_at",{ascending:false});
    if(r) setReports(r); if(b) setBanned(b);
  };
  const ban = async (username:string, days:number, reason:string) => {
    const exp = days===9999? null : new Date(Date.now()+days*86400000).toISOString();
    await supabase.from("banned_users").upsert({username, reason, is_permanent: days===9999, expires_at: exp});
    await supabase.from("reports").update({status:"resolved"}).eq("reported_username",username);
    load();
  };
  const unban = async (username:string) => { await supabase.from("banned_users").delete().eq("username",username); load(); };
  return (
    <div className="min-h-screen bg-black text-white p-4 max-w-2xl mx-auto">
      <h1 className="text-2xl font-bold mb-4">Admin Safety Panel</h1>
      <h2 className="font-bold mt-6">Reports ({reports.length})</h2>
      {reports.map((r:any)=><div key={r.id} className="bg-zinc-900 p-3 rounded-xl mt-2 flex justify-between">
        <div><p className="text-sm"><b>@{r.reported_username}</b> reported by @{r.reporter_username}</p><p className="text-xs text-zinc-400">{r.reason}: {r.details}</p></div>
        <div className="flex gap-2"><button onClick={()=>ban(r.reported_username,1,r.reason)} className="bg-yellow-600 px-2 rounded-full text-xs">Ban 1d</button><button onClick={()=>ban(r.reported_username,9999,r.reason)} className="bg-red-600 px-2 rounded-full text-xs">Perma</button></div>
      </div>)}
      <h2 className="font-bold mt-6">Banned ({banned.length})</h2>
      {banned.map((b:any)=><div key={b.id} className="bg-zinc-900 p-3 rounded-xl mt-2 flex justify-between"><span>@{b.username} - {b.reason}</span><button onClick={()=>unban(b.username)} className="bg-[#00f2ea] text-black px-3 rounded-full text-xs">Unban</button></div>)}
    </div>
  );
}
