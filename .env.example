# Copy to `.env` for local development: cp .env.example .env
#
# `.env` is gitignored and must never be committed. A key committed here stays
# readable in git history even after a later commit blanks it, which is how the
# previous Giphy key ended up banned.
#
# Anything prefixed VITE_ is inlined into the browser bundle by Vite and is
# therefore PUBLIC. Never put a secret behind a VITE_ name.

APP_URL=
GIPHY_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_CSE_KEY=
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
PEXELS_API_KEY=
REPORT_EMAIL_WEBHOOK_URL=
REPORT_FROM_EMAIL=
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PASS=
SMTP_PORT=
SMTP_USER=
STRIPE_SECRET_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
TREMENDOUS_API_KEY=
TREMENDOUS_FUNDING_SOURCE_ID=
TIKTOK_ACCESS_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
VAPID_SERVER_PRIVATE_KEY=
VAPID_SERVER_PUBLIC_KEY=
VAPID_SUBJECT=
VENMO_RECIPIENT=
VITE_APP_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_GOOGLE_PAY_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_VAPID_PUBLIC_KEY=