import { supabase } from "@/integrations/supabase/client";

export type SubscriptionPlan = "basic" | "premium";
export type SubscriptionStatus = "active" | "canceled" | "past_due" | "inactive";

export type SubscriptionRow = {
  id: string;
  user_id: string;
  plan: SubscriptionPlan;
  status: SubscriptionStatus;
  stripe_customer_id: string | null;
  current_period_end: string | null;
  created_at: string;
};

export const OWNER_USERNAME = "drewmclawhorn3";

export function isOwnerUsername(handle?: string | null): boolean {
  return (handle ?? "").trim().toLowerCase() === OWNER_USERNAME;
}

export function formatPremiumUntil(currentPeriodEnd?: string | null): string {
  if (!currentPeriodEnd) return "Premium";
  const date = new Date(currentPeriodEnd);
  if (Number.isNaN(date.getTime())) return "Premium";
  return `Premium until ${date.toLocaleString("en-US", {
    month: "short",
    day: "numeric",
  })}`;
}

export async function fetchLatestSubscription(
  userId?: string | null,
): Promise<SubscriptionRow | null> {
  if (!userId) return null;

  const { data, error } = await supabase
    .from("subscriptions")
    .select("*")
    .eq("user_id", userId)
    .order("created_at", { ascending: false })
    .limit(1)
    .maybeSingle();

  if (error) {
    console.warn("Failed to load subscription row", error.message);
    return null;
  }

  return (data as SubscriptionRow | null) ?? null;
}

export function isSubscriptionActive(sub: SubscriptionRow | null): boolean {
  if (!sub) return false;
  if (sub.status !== "active") return false;
  if (!sub.current_period_end) return true;

  const endTs = new Date(sub.current_period_end).getTime();
  return Number.isFinite(endTs) && endTs > Date.now();
}

export async function canAccessAppForUser(
  user: { id?: string | null; handle?: string | null } | null,
): Promise<boolean> {
  if (!user?.id) return false;
  if (isOwnerUsername(user.handle)) return true;

  const sub = await fetchLatestSubscription(user.id);
  return isSubscriptionActive(sub);
}
